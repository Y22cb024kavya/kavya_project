# VOKTAA Solutions Production Apache Configuration

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS 301 Permanent Redirect
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Force non-www (www.voktaa.com -> voktaa.com) 301 Permanent Redirect
  RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3. Serve existing static files & pre-rendered route folders directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Fallback to route index.html if pre-rendered, otherwise main index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security & SEO Headers for Admin Routes
<IfModule mod_headers.c>
  <FilesMatch "^admin">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Core Web Vitals Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching Rules for Core Web Vitals
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
